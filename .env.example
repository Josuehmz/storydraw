# Copia este archivo a `.env` (en la raíz del repo) y rellena los valores.
# docker compose y el backend lo leen. Nunca subas el `.env` real.

# --- General ---
ENTORNO=desarrollo
URL_PUBLICA=http://localhost:8000
CORS_ORIGENES=
# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios
JWT_SECRETO=
JWT_MINUTOS=
VERSION_CONSENTIMIENTO=
ADMIN_EMAILS=
CONTENIDO_EMAILS=

# --- Base de datos (docker compose arma DATABASE_URL con estos tres) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Solo si corres el backend fuera de docker compose
DATABASE_URL=

# --- Proveedores: openai | falso (falso = sin red, solo desarrollo) ---
PROVEEDOR_VISION=
PROVEEDOR_TEXTO=
PROVEEDOR_IMAGEN=
# elevenlabs | falso
PROVEEDOR_VOZ=
# smtp | falso
PROVEEDOR_CORREO=
# s3 | memoria
ALMACEN=

# --- OpenAI: una sola clave para visión, cuento, moderación e imagen ---
OPENAI_API_KEY=
OPENAI_MODELO_VISION=
OPENAI_MODELO_TEXTO=
OPENAI_MODELO_MODERACION=
OPENAI_MODELO_IMAGEN=
OPENAI_CALIDAD_IMAGEN=
OPENAI_TAMANO_IMAGEN=
OPENAI_ESFUERZO_RAZONAMIENTO=

# --- ElevenLabs: narración ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ_ID=
ELEVENLABS_MODELO=

# --- Correo transaccional (SMTP) ---
SMTP_HOST=
SMTP_PUERTO=
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
# starttls | ssl | ninguna
SMTP_SEGURIDAD=

# --- Almacén S3 compatible (en docker compose, MinIO usa las mismas claves) ---
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CIFRADO_SSE=

# --- Composición: rembg | umbral ---
RECORTE=

# --- Orquestador ---
REINTENTOS_POR_PASO=
ESPERA_REINTENTO_S=
MAX_REGENERACIONES=
TIMEOUT_PROVEEDOR_S=

# --- Límite de tasa (formato slowapi, p. ej. 5/minute) ---
LIMITE_AUTH=
LIMITE_IDENTIFICAR=
LIMITE_CUENTOS_IP=
LIMITE_CUENTOS_CUENTA=
# memory:// o redis://... si hay varias réplicas
LIMITE_TASA_ALMACEN=
