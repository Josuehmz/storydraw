# Copia este archivo a `.env` (en la raíz del repo) y rellena los valores.
# docker compose y el backend lo leen. Nunca subas el `.env` real.

# --- General ---
ENTORNO=desarrollo
# Dirección con la que el TELÉFONO llega al backend: va dentro del enlace del correo de
# confirmación. localhost no sirve (en el teléfono sería el propio teléfono):
#   emulador de Android:  http://10.0.2.2:8000
#   teléfono real (misma Wi-Fi): http://IP-DE-TU-PC:8000   (ipconfig)
#   producción: la URL https pública del backend
URL_PUBLICA=http://localhost:8000
# Dominios de correo que pueden crear cuenta, separados por coma. Vacío = cualquiera.
# Si queda vacío toma el valor por defecto: gmail.com,hotmail.com
DOMINIOS_CORREO=
CORS_ORIGENES=
# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios
JWT_SECRETO=
JWT_MINUTOS=
VERSION_CONSENTIMIENTO=
ADMIN_EMAILS=
CONTENIDO_EMAILS=

# --- Base de datos (docker compose arma DATABASE_URL con estos tres) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Solo si corres el backend fuera de docker compose
DATABASE_URL=

# --- Proveedores: un adaptador por capacidad (falso = sin red, solo desarrollo) ---
# Producción/piloto gratis: cloudflare. Prueba local gratis: ollama (ver docker-compose.ollama.yml).
# openai | cloudflare | ollama | falso
PROVEEDOR_VISION=
# openai | cloudflare | ollama | falso
PROVEEDOR_TEXTO=
# openai | cloudflare | ollama | falso   (obligatoria, sin interruptor)
#   openai: endpoint de moderación, gratis pero pide OPENAI_API_KEY. El único válido en producción.
#   cloudflare | ollama: LLM genérico clasificando el cuento. SOLO DESARROLLO; falla cerrada.
PROVEEDOR_MODERACION=
# openai | cloudflare | ninguno | falso   (ninguno = se usa un fondo del banco)
PROVEEDOR_IMAGEN=
# cloudflare | ninguno | falso   (ninguno = el cuento sale sin audio; es lo que pasa si queda vacío)
#   cloudflare: MeloTTS en español, gratis dentro de las neuronas del día. Una sola voz.
PROVEEDOR_VOZ=
# smtp | falso
PROVEEDOR_CORREO=
# s3 | memoria
ALMACEN=

# --- Cloudflare Workers AI (10.000 neuronas/día gratis) ---
CLOUDFLARE_ACCOUNT_ID=
# Token con permiso Workers AI (Read/Edit). Nunca en el código ni en un commit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODELO_VISION=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_MODELO_TEXTO=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_MODELO_MODERACION=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_MODELO_IMAGEN=@cf/black-forest-labs/flux-1-schnell
# Pasos de difusión de flux-1-schnell (1 a 8)
CLOUDFLARE_PASOS_IMAGEN=4
# true envía chat_template_kwargs.enable_thinking=false (Gemma 4, Qwen 3); false si el modelo no lo acepta
CLOUDFLARE_DESACTIVAR_RAZONAMIENTO=true
CLOUDFLARE_TIMEOUT_S=120
# Costo para el panel: neuronas del modelo convertidas a USD (tarifas publicadas)
CLOUDFLARE_USD_POR_MIL_NEURONAS=0.011
CLOUDFLARE_NEURONAS_TEXTO_ENTRADA_MTOK=9091
CLOUDFLARE_NEURONAS_TEXTO_SALIDA_MTOK=27273
CLOUDFLARE_NEURONAS_VISION_ENTRADA_MTOK=9091
CLOUDFLARE_NEURONAS_VISION_SALIDA_MTOK=27273
CLOUDFLARE_NEURONAS_IMAGEN_TESELA=4.80
CLOUDFLARE_NEURONAS_IMAGEN_PASO=9.60
# Voz (MeloTTS): idioma y neuronas por minuto de audio (tarifa publicada)
CLOUDFLARE_MODELO_VOZ=@cf/myshell-ai/melotts
CLOUDFLARE_IDIOMA_VOZ=es
CLOUDFLARE_NEURONAS_VOZ_MINUTO=18.63

# --- Ollama (prueba local, costo 0): solo texto, visión y moderación de desarrollo ---
# Fuera de Docker: http://localhost:11434. En docker compose el override usa host.docker.internal.
OLLAMA_URL=http://localhost:11434
# gemma3:4b ve imágenes: un solo modelo (ollama pull gemma3:4b) para las tres capacidades
OLLAMA_MODELO_TEXTO=gemma3:4b
OLLAMA_MODELO_VISION=gemma3:4b
OLLAMA_MODELO_MODERACION=gemma3:4b
# Por CPU un cuento tarda minutos
OLLAMA_TIMEOUT_S=900

# --- OpenAI: visión, cuento, moderación e imagen con una sola clave ---
OPENAI_API_KEY=
OPENAI_MODELO_VISION=
OPENAI_MODELO_TEXTO=
OPENAI_MODELO_MODERACION=
OPENAI_MODELO_IMAGEN=
OPENAI_CALIDAD_IMAGEN=
OPENAI_TAMANO_IMAGEN=
OPENAI_ESFUERZO_RAZONAMIENTO=

# --- Correo transaccional (SMTP) ---
# Para que el correo de confirmación llegue de verdad con una cuenta de Gmail:
#   1. Activa la verificación en dos pasos de esa cuenta de Google.
#   2. Crea una «contraseña de aplicación» en https://myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com  SMTP_PUERTO=587  SMTP_SEGURIDAD=starttls
#      SMTP_USUARIO=tucuenta@gmail.com  SMTP_CONTRASENA=<la contraseña de aplicación>
#      SMTP_REMITENTE=StoryDraw <tucuenta@gmail.com>
# Gmail limita unos 500 correos al día: sirve para pruebas y un piloto pequeño.
# Con docker compose, Mailpit (http://localhost:8025) captura los correos sin enviarlos.
SMTP_HOST=
SMTP_PUERTO=
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
# starttls | ssl | ninguna
SMTP_SEGURIDAD=

# --- Almacén S3 compatible (en docker compose, MinIO usa las mismas claves) ---
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CIFRADO_SSE=

# --- Composición: rembg | umbral ---
RECORTE=

# --- Orquestador ---
REINTENTOS_POR_PASO=
ESPERA_REINTENTO_S=
MAX_REGENERACIONES=
TIMEOUT_PROVEEDOR_S=

# --- Límite de tasa (formato slowapi, p. ej. 5/minute) ---
LIMITE_AUTH=
LIMITE_IDENTIFICAR=
LIMITE_CUENTOS_IP=
LIMITE_CUENTOS_CUENTA=
# memory:// o redis://... si hay varias réplicas
LIMITE_TASA_ALMACEN=
